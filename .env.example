PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=centro_pediatrico_db
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES_MINIMO
JWT_ISSUER=centro-pediatrico-dev
JWT_AUDIENCE=centro-pediatrico-api
# development habilita POST /auth/dev-login; production lo deshabilita.
NODE_ENV=development
# Opcional: ENABLE_DEV_LOGIN=false desactiva el acceso de desarrollo aunque NODE_ENV=development.
# ENABLE_DEV_LOGIN=false
# Opcional: orígenes permitidos (CORS) si el frontend compartido se sirve en otro dominio.
# CORS_ORIGIN=http://localhost:5174
# Opcional (solo administrador): URI con privilegio dbAdmin para "npm run db:validadores -- --aplicar".
# MONGO_ADMIN_URI=
# Solo pruebas (npm test / npm run test:e2e): ruta de mongod.exe si no está en la ruta estándar.
# MONGOD_BIN=C:\Program Files\MongoDB\Server\9.0\bin\mongod.exe
